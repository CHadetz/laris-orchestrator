# Long-lived OAuth token for headless `claude -p` (run: claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# Linear personal API key (Settings → API → Personal API keys)
LINEAR_API_KEY=

# Linear webhook signing secret (Settings → API → Webhooks)
LINEAR_WEBHOOK_SECRET=

# GitHub PAT with repo + workflow scopes
GITHUB_TOKEN=

# GitHub webhook signing secret. Required to react to PR comments.
# Settings → Webhooks → "Secret" field when creating the repo webhook.
GITHUB_WEBHOOK_SECRET=

# GitHub login of the user/app whose PAT we're using above. If set, comments
# authored by this login are ignored (prevents self-loops).
# GITHUB_BOT_LOGIN=

# Label name on a Linear ticket that triggers execution
APPROVAL_LABEL=agent:approved

# HTTP server port
PORT=4000

# SQLite DB file
DB_PATH=./data/orchestrator.db

# Absolute local path to the repo the agent should read/edit
REPO_PATH=/Users/example/projects/my-repo

# Base branch subagents branch off and target with PRs (default: main)
BASE_BRANCH=main

# Where execution worktrees are created. Defaults to a sibling .laris-worktrees/ dir next to REPO_PATH.
# WORKTREE_ROOT=/Users/example/projects/.laris-worktrees

# Hard timeout per subagent run, in milliseconds (default: 3600000 = 1h)
# EXECUTION_TIMEOUT_MS=3600000

# Shell command run inside the agent's worktree after it claims PR success.
# If non-zero exit, the ticket is marked failed and a Linear comment shows the
# tail of the output. Unset = no independent verification (trust the agent).
# VERIFICATION_COMMAND=npm run check

# Hard timeout for the verification command, in milliseconds (default: 600000 = 10m)
# VERIFICATION_TIMEOUT_MS=600000

# Max auto-fix attempts when verification fails. Each attempt is a full subagent
# run that gets the failure output and tries to fix it. 0 disables auto-retry.
# VERIFICATION_MAX_RETRIES=2

# Model the planner uses. Accepts "opus", "sonnet", "haiku", or a full model id
# like "claude-opus-4-7". Default: opus (most capable).
# PLANNER_MODEL=opus

# Cumulative Anthropic spend cap per Linear ticket (USD). Covers planner +
# executor + verification-fix + follow-up runs combined. When the cap is hit,
# the next subagent spawn is refused and a notification posts to Linear (or
# the PR for followups). 0 = no cap.
# MAX_COST_USD_PER_TICKET=5

# Linear workflow state names to transition to. Case-insensitive, looked up per
# team. If your team uses different names (e.g. "Code Review"), override.
# IN_PROGRESS_STATE_NAME=In Progress
# IN_REVIEW_STATE_NAME=In Review
